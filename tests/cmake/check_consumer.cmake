cmake_minimum_required(VERSION 3.16)
if(NOT CONFIG)
    set(CONFIG Release)
endif()
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef run_id)
set(test_root "${BINARY_DIR}/package-smoke/${run_id}")
set(original "${test_root}/original")
set(relocated "${test_root}/relocated install")

function(run_checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${error}")
    endif()
endfunction()

run_checked("${CMAKE_COMMAND}" --install "${BINARY_DIR}" --config "${CONFIG}" --prefix "${original}")
file(COPY "${original}/" DESTINATION "${relocated}")
if(NOT EXISTS "${relocated}/include/DecrampEQ.hpp")
    message(FATAL_ERROR "Installed single header is missing")
endif()
set(generator_args -G "${GENERATOR}")
if(PLATFORM)
    list(APPEND generator_args -A "${PLATFORM}")
endif()
if(TOOLSET)
    list(APPEND generator_args -T "${TOOLSET}")
endif()
foreach(mode IN ITEMS installed subdirectory)
    set(consumer_build "${test_root}/${mode}")
    set(extra_args)
    if(COMPILER_ARG1)
        list(APPEND extra_args "-DCMAKE_CXX_COMPILER_ARG1=${COMPILER_ARG1}")
    endif()
    if(MAKE_PROGRAM)
        list(APPEND extra_args "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
    endif()
    if(mode STREQUAL installed)
        list(APPEND extra_args "-DEXPECTED_PREFIX=${relocated}")
    else()
        list(APPEND extra_args "-DDECRAMPEQ_SOURCE_DIR=${SOURCE_DIR}")
    endif()
    run_checked("${CMAKE_COMMAND}" -S "${SOURCE_DIR}/tests/consumer" -B "${consumer_build}"
        ${generator_args} "-DCMAKE_CXX_COMPILER=${COMPILER}" -DCMAKE_BUILD_TYPE=Release ${extra_args})
    run_checked("${CMAKE_COMMAND}" --build "${consumer_build}" --config "${CONFIG}")
    if(EXISTS "${consumer_build}/${CONFIG}/decramp_consumer.exe")
        set(executable "${consumer_build}/${CONFIG}/decramp_consumer.exe")
    elseif(EXISTS "${consumer_build}/decramp_consumer.exe")
        set(executable "${consumer_build}/decramp_consumer.exe")
    else()
        set(executable "${consumer_build}/decramp_consumer")
    endif()
    run_checked("${executable}")
endforeach()
message(STATUS "Relocated find_package() and add_subdirectory() consumers passed")
